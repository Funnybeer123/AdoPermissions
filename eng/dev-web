#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root/src/AccessManager.Web"
if [[ ! -d node_modules ]]; then
  npm install
fi
echo "Access Manager is on http://localhost:4780"
echo "Contoso fake inventory is always available."
echo "Sandbox evanbeer is read-only and needs AZURE_DEVOPS_PAT in the environment."
npm run dev
